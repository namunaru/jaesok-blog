---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// 유튜브 주소에서 썸네일 추출하는 함수
function getYouTubeThumbnail(url: string) {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
  const match = url.match(regExp);
  return (match && match[2].length === 11)
    ? `https://img.youtube.com/vi/${match[2]}/maxresdefault.jpg`
    : '/fallback-image.png';
}

const reviews = (await getCollection('review')).filter((p: any) => !p.data.draft).sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const videos = (await getCollection('video')).sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const essays = (await getCollection('essays')).filter((p: any) => !p.data.draft).sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const seriesList = (await getCollection('series')).filter((p: any) => !p.data.draft).sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0));

const featuredBooks = [
  { title: "1984", author: "조지 오웰", link: "#" },
  { title: "오만과 편견", author: "제인 오스틴", link: "#" },
  { title: "이방인", author: "알베르 카뮈", link: "#" },
  { title: "멋진 신세계", author: "올더스 헉슬리", link: "#" },
  { title: "제인 에어", author: "샬럿 브론테", link: "#" },
  { title: "드라큘라", author: "브램 스토커", link: "#" }
];

const themes = ["사랑과 결혼", "권력과 감시", "소외와 부조리", "인간의 욕망", "여성과 사회"];
---

<BaseLayout title="Gedsc | 세계문학 기록실">
  <div class="modern-archive">
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-bg-container">
        <div class="hero-bg night"></div>
        <div class="hero-bg dawn"></div>
        <div class="hero-bg day"></div>
        <div class="hero-bg sunset"></div>
      </div>
      <div class="hero-content">
        <h1 class="hero-title serif">고전을 오늘의 언어로<br/>다시 읽는 디지털 서재</h1>
        <p class="hero-subtitle">기록하고, 사유하고, 찬찬히 공유하는 문학의 흔적</p>
        <div class="hero-btns">
          <a href="/archive" class="btn btn-primary">아카이브 둘러보기</a>
          <a href="/video" class="btn btn-secondary">대표 영상 보기</a>
        </div>
      </div>
    </section>

    <!-- Featured Works -->
    <section class="section container">
      <div class="section-header">
        <h2 class="serif section-title">Featured Works</h2>
      </div>
      <div class="book-grid">
        {featuredBooks.map(book => (
          <div class="book-card">
            <div class="book-cover-placeholder"></div>
            <h3 class="serif book-title">{book.title}</h3>
            <p class="book-author">{book.author}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Explore by Theme -->
    <section class="section theme-section">
      <div class="container">
        <div class="section-header">
          <h2 class="serif section-title">Explore by Theme</h2>
        </div>
        <div class="theme-list">
          {themes.map(theme => (
            <a href={`/archive?theme=${theme}`} class="theme-tag">{theme}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- Latest Content (videos + essays) -->
    <section class="section container dual-grid">
      <div class="latest-videos">
        <div class="section-header">
          <h2 class="serif section-title">Latest Videos</h2>
          <a href="/video" class="more-link">View all</a>
        </div>
        <div class="video-grid-mini">
          {videos.map((video: any) => (
            <a href={`/video/${video.slug}`} class="video-item">
              <div class="video-thumb">
                <img src={getYouTubeThumbnail(video.data.youtube)} alt={video.data.title} />
              </div>
              <h4 class="video-item-title">{video.data.title}</h4>
            </a>
          ))}
        </div>
      </div>

      <div class="latest-essays">
        <div class="section-header">
          <h2 class="serif section-title">Latest Essays</h2>
          <a href="/essays" class="more-link">View all</a>
        </div>
        <div class="essay-list">
          {essays.map((essay: any) => (
            <div class="essay-item">
              <span class="essay-cat">{essay.data.category}</span>
              <h4 class="serif essay-title">{essay.data.title}</h4>
              <p class="essay-desc">{essay.data.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Series -->
    <section class="section container">
      <div class="section-header">
        <h2 class="serif section-title">Series</h2>
      </div>
      <div class="series-grid">
        {seriesList.map((series: any) => (
          <div class="series-card">
            <h3 class="serif series-title">{series.data.title}</h3>
            <p class="series-desc">{series.data.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- About Preview -->
    <section class="section about-preview">
      <div class="container">
        <div class="about-card">
          <div class="about-text">
            <h2 class="serif about-title">About Gedsc</h2>
            <p>Gedsc 세계문학 기록실은 시대를 관통하는 고전의 지혜를 현대의 감각으로 기록합니다. 단편적인 리뷰를 넘어 깊이 있는 사유와 공유의 장을 지향합니다.</p>
            <a href="/about" class="text-link">저희의 철학 읽어보기 →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="section newsletter-cta">
      <div class="container">
        <div class="newsletter-box">
          <h2 class="serif">조용한 세계문학 서재의 편지를 받아보세요</h2>
          <p>매주 새로운 고전 읽기의 영감을 이메일로 보내드립니다.</p>
          <div class="subscribe-form">
            <input type="email" placeholder="이메일 주소를 입력하세요" />
            <button>Subscribe</button>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  :root {
    --bg-white: #ffffff;
    --bg-light: #f8f8f8;
    --text-charcoal: #1a1a1a;
    --text-gray: #666666;
    --accent: #2c3e50;
    --border: #eeeeee;
  }

  .modern-archive {
    background: var(--bg-white);
    color: var(--text-charcoal);
  }

  .serif { font-family: 'Noto Serif KR', serif; }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .section { padding: 80px 0; }
  .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
  .section-title { font-size: 2rem; margin: 0; }
  .more-link { font-size: 0.9rem; color: var(--text-gray); text-decoration: underline; }

  /* Hero Section */
  .hero-section {
    position: relative;
    height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color: #fff;
  }

  .hero-bg-container {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1;
  }

  .hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: heroFade 32s infinite ease-in-out;
  }

  .hero-bg.night { background-image: url('/images/Gedsc_TimeFixed_1_Night.png'); animation-delay: 0s; }
  .hero-bg.dawn { background-image: url('/images/Gedsc_TimeFixed_2_Dawn.png'); animation-delay: 8s; }
  .hero-bg.day { background-image: url('/images/Gedsc_TimeFixed_3_Day.png'); animation-delay: 16s; }
  .hero-bg.sunset { background-image: url('/images/Gedsc_TimeFixed_4_Sunset.png'); animation-delay: 24s; }

  @keyframes heroFade {
    0%, 25%, 100% { opacity: 0; }
    5%, 20% { opacity: 1; }
  }

  .hero-section::after {
    content: '';
    position: absolute; top:0; left:0; width:100%; height:100%;
    background: rgba(0,0,0,0.4);
    z-index: 2;
  }

  .hero-content { position: relative; z-index: 3; }
  .hero-title { font-size: 3.5rem; line-height: 1.2; margin-bottom: 20px; }
  .hero-subtitle { font-size: 1.2rem; opacity: 0.9; margin-bottom: 40px; }
  .hero-btns { display: flex; gap: 20px; justify-content: center; }

  .btn {
    padding: 12px 30px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
  }
  .btn-primary { background: #fff; color: #1a1a1a; }
  .btn-secondary { background: rgba(255,255,255,0.2); color: #fff; border: 1px solid #fff; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.2); }

  /* Book Grid */
  .book-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 30px; }
  .book-cover-placeholder { aspect-ratio: 2/3; background: var(--bg-light); border: 1px solid var(--border); border-radius: 4px; margin-bottom: 15px; }
  .book-title { font-size: 1.1rem; margin-bottom: 5px; }
  .book-author { font-size: 0.85rem; color: var(--text-gray); }

  /* Theme Section */
  .theme-section { background: var(--bg-light); text-align: center; }
  .theme-list { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; }
  .theme-tag {
    padding: 10px 25px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 50px;
    color: var(--text-charcoal);
    font-size: 0.95rem;
    transition: 0.3s;
  }
  .theme-tag:hover { background: var(--text-charcoal); color: #fff; }

  /* Latest Content */
  .dual-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 80px; }
  .video-grid-mini { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .video-thumb { aspect-ratio: 16/9; background: #000; overflow: hidden; border-radius: 4px; margin-bottom: 10px; }
  .video-thumb img { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; transition: 0.3s; }
  .video-item:hover img { opacity: 1; transform: scale(1.05); }
  .video-item-title { font-size: 0.9rem; line-height: 1.4; color: var(--text-charcoal); }

  .essay-item { padding: 25px 0; border-bottom: 1px solid var(--border); }
  .essay-item:first-child { padding-top: 0; }
  .essay-cat { color: var(--text-charcoal); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; }
  .essay-title { font-size: 1.3rem; margin: 10px 0; }
  .essay-desc { font-size: 0.9rem; color: var(--text-gray); line-height: 1.6; }

  /* Series */
  .series-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .series-card { padding: 40px; border: 1px solid var(--border); border-radius: 4px; transition: 0.3s; }
  .series-card:hover { border-color: var(--text-charcoal); }
  .series-title { font-size: 1.5rem; margin-bottom: 15px; }
  .series-desc { font-size: 0.95rem; color: var(--text-gray); line-height: 1.6; }

  /* About Preview */
  .about-preview { background: var(--bg-light); }
  .about-card { background: #fff; padding: 60px; border-radius: 4px; border: 1px solid var(--border); max-width: 800px; margin: 0 auto; text-align: center; }
  .about-title { font-size: 2.2rem; margin-bottom: 25px; }
  .about-card p { font-size: 1.1rem; line-height: 1.8; color: var(--text-gray); margin-bottom: 30px; }
  .text-link { font-weight: 600; color: var(--text-charcoal); text-decoration: none; border-bottom: 2px solid var(--text-charcoal); }

  /* Newsletter CTA */
  .newsletter-box { background: var(--text-charcoal); color: #fff; padding: 80px 60px; border-radius: 4px; text-align: center; }
  .newsletter-box h2 { font-size: 2rem; margin-bottom: 15px; }
  .newsletter-box p { opacity: 0.8; margin-bottom: 40px; }
  .subscribe-form { display: flex; gap: 10px; max-width: 500px; margin: 0 auto; }
  .subscribe-form input { flex: 1; padding: 15px; border-radius: 4px; border: none; font-size: 1rem; }
  .subscribe-form button { padding: 15px 30px; background: #fff; color: var(--text-charcoal); border: none; border-radius: 4px; font-weight: 700; cursor: pointer; transition: 0.3s; }
  .subscribe-form button:hover { background: #eee; }

  @media (max-width: 768px) {
    .dual-grid { grid-template-columns: 1fr; gap: 60px; }
    .book-grid { grid-template-columns: repeat(2, 1fr); }
    .series-grid { grid-template-columns: 1fr; }
    .hero-title { font-size: 2.2rem; }
    .container { padding: 0 20px; }
  }
</style>
<footer class="site-footer">
  <div class="container">
    <div class="footer-links">
      <a href="/about">소개</a>
      <a href="/contact">문의</a>
      <a href="https://youtube.com/@gedsc">유튜브</a>
      <a href="https://blog.naver.com/gedsc">블로그</a>
    </div>
    <p>© 2026 Gedsc. 세계문학 기록실.</p>
  </div>
</footer>